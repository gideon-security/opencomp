{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testPathIgnorePatterns": ["/node_modules/"],
  "transform": {
    "^.+\\.m?[tj]sx?$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@maced/api-client|better-auth|@better-auth|@noble|@better-auth|@better-fetch|jose|nanostores|better-call|zod|kysely|rou3|@standard-schema|@opentelemetry|@inference)/)"
  ],
  "moduleNameMapper": {
    "^@db$": "<rootDir>/test/__mocks__/db.ts",
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@gideon-defender/auth$": "<rootDir>/test/__mocks__/trycompai-auth.ts",
    "^@gideon-defender/company$": "<rootDir>/../../packages/company/src/index.ts",
    "^@gideon-defender/db$": "<rootDir>/test/__mocks__/db.ts",
    "^@gideon-defender/email$": "<rootDir>/../../packages/email/index.ts",
    "^@gideon-defender/integration-platform$": "<rootDir>/../../packages/integration-platform/src/index.ts",
    "^@gideon-defender/utils/(.*)$": "<rootDir>/../../packages/utils/src/$1.ts",
    "^@thallesp/nestjs-better-auth$": "<rootDir>/test/__mocks__/nestjs-better-auth.ts",
    "^better-auth/node$": "<rootDir>/test/__mocks__/better-auth-node.ts",
    "^better-auth/plugins$": "<rootDir>/test/__mocks__/better-auth-plugins.ts"
  },
  "globals": {
    "ts-jest": {
      "tsconfig": "<rootDir>/tsconfig.json"
    }
  }
}
