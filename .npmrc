registry=https://registry.npmjs.org/
# Tolerate flaky registry access (dropped TLS mid-fetch): retry with backoff.
fetch-retries=5
fetch-retry-maxtimeout=120000
# Always resolve workspace members locally, never from the registry — even
# for "*" ranges. (Without these, pnpm may try the registry first and 404 on
# our private @gideon-defender/* names instead of linking the workspace.)
link-workspace-packages=true
prefer-workspace-packages=true
# Radix primitives coordinate through module-level singletons (layer stack,
# focus-scope stack): popover and dialog MUST resolve to the same files or
# Escape/focus-trap behavior breaks (see CS-748/CS-755). Hoist them flat like
# npm did so every importer shares one copy.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@radix-ui/*
